rated RSU wind-down.\n2. Discuss trimming AAPL single-stock (RSU) toward the 10% policy target.\n3. Flag $200,000 of harvestable losses (~$47,600 illustrative tax alpha) ahead of year-end.\n4. Walk through the CIO's current view: Diversify concentrated employer stock ahead of retirement\n\n### Eligible next steps\n- Alternatives\n- Private Banking\n- Trust & Estate\n- Insurance / Annuity\n- Charitable / Gifting Overlay"},"verdict":{"kaplan":["§54",["§30","¶15","¶10","¶22",[],[],[],[],[],[["§27",42,true,[["§28",11,"EQ",true,true]],1],["§29",41,true,[["§28",10,"EQ",true,true]]],["§29",45,true,[["§28",24,"EQ",true,true]]],["§29",46,true,[["§28",23,"EQ",true,true]]],["§29",43,true,[["§28",36,"EQ",false,false],["§28",29,"EQ",true,false]]],["§29",44,true,[["§28",9,"EQ",false,false],["§28",18,"EQ",true,null]]]],"¶3"],["§25","mgiTer","¶214","¶19",[{"rule_id":54}],[],[],[],[],[],"¶3",["§30","¶15","¶10","¶22",[],[],[],[],[],[["§27",42,true,[["§28",11,"EQ",true,true]],1],["§29",41,true,[["§28",10,"EQ",true,true]]],["§29",45,true,[["§28",24,"EQ",true,true]]],["§29",46,true,[["§28",23,"EQ",true,true]]],["§29",43,true,[["§28",36,"EQ",false,false],["§28",29,"EQ",true,false]]],["§29",44,true,[["§28",9,"EQ",false,false],["§28",18,"EQ",true,null]]]],"¶3"]],["§25","mgiQlh","¶215","¶19",[{"rule_id":54,"message":"¶67"}],[],[],[],[],[],"¶3",["§30","¶15","¶10","¶22",[],[],[],[],[],[["§27",42,true,[["§28",11,"EQ",true,true]],1],["§29",41,true,[["§28",10,"EQ",true,true]]],["§29",45,true,[["§28",24,"EQ",true,true]]],["§29",46,true,[["§28",23,"EQ",true,true]]],["§29",43,true,[["§28",36,"EQ",false,false],["§28",29,"EQ",true,false]]],["§29",44,true,[["§28",9,"EQ",false,false],["§28",18,"EQ",true,null]]]],"¶3"]],["§25","mgiDtlh","¶203","¶19",[{"rule_id":54,"message":"¶66"}],[],[],[],[],[],"¶3",["§30","¶15","¶10","¶22",[],[],[],[],[],[["§27",42,true,[["§28",11,"EQ",true,true]],1],["§29",41,true,[["§28",10,"EQ",true,true]]],["§29",45,true,[["§28",24,"EQ",true,true]]],["§29",46,true,[["§28",23,"EQ"